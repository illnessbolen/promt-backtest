# Optional overrides for config.yaml (copy to .env). No secrets are needed: all sources are public.
# BOSONA_CONFIG=config.yaml
# BOSONA_DB_PATH=data/bosona.db
# BOSONA_LOG_LEVEL=DEBUG
# BOSONA_USER=0xc2ad03f79ca3f3c17d8c7de2612ce0c89b7d40ed
# BOSONA_LIVE_DB_PATH=data/live.db
#
# Stage 3, optional: Chainlink Data Streams (paid access, not a wallet key). When both values are set the
# `chainlink_data_streams` price provider switches on by itself; no code change needed.
# CHAINLINK_DS_API_KEY=
# CHAINLINK_DS_USER_SECRET=
# CHAINLINK_DS_WS_URL=wss://ws.dataengine.chain.link
# CHAINLINK_DS_FEEDS=btc:spot=0x00039d9e45394f473ab1f050a1b963e6b05351e52d71e507509ada0c95ed75b8,btc:twap60=0x...
